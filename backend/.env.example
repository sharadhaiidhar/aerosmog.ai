# ─────────────────────────────────────────────
# AeroSmog.AI — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# WAQI (Air Quality) API Key — free at https://aqicn.org/data-platform/token/
WAQI_API_KEY=your_waqi_token_here

# Groq API Key — free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# (Optional) Gemini API Key fallback — free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Database file path
DATABASE_URL=sqlite:///./aerosmog.db

# CORS origins (comma-separated) for frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
